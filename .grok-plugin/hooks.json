{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AG=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/agent_glance.py\"; test -f \"$AG\" && python3 \"$AG\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AG=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/agent_glance.py\"; test -f \"$AG\" && python3 \"$AG\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AG=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/agent_glance.py\"; test -f \"$AG\" && python3 \"$AG\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
