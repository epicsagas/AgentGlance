{
  "agent-glance": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_permission",
        "type": "command",
        "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
        "timeout": 10
      }
    ]
  }
}
