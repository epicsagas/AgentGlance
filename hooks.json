{
  "agent-glance": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
            "timeout": 10
          }
        ],
        "description": "SmallTV: show WORKING when the model is invoked"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_permission",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
            "timeout": 10
          }
        ],
        "description": "SmallTV: show APPROVAL when the agent asks permission"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/agent-glance/scripts/agent_glance.py\"",
            "timeout": 10
          }
        ],
        "description": "SmallTV: show DONE when the execution loop terminates"
      }
    ]
  }
}
